extends layout

block content
  h1= title
  p Welcome to #{title}
  // falto la internacionalización de esta parte nomas, pero esto va a cambiar de todas formas
  table
    tr
        th Nombre
        th descripción
        th Marca
        th Precio
    each product in products
        tr
            td=product.name
            td=product.description
            td=product.brand
            td=product.price